# API local environment (safe examples only)
# Copy to .env.local (gitignored). Never put real credentials here.

WORKOS_DEV_OPERATOR_BYPASS=0
WORKOS_DEV_OPERATOR_PERSON_ID=

# Production / isolated Cloud (examples only — no real HUB MEDIA paths)
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=8787
# WORKOS_CLOUD_ROOT=
# WORKOS_BACKUP_ROOT=
# WORKOS_PUBLIC_ORIGIN=https://workos.example
# WORKOS_TRUSTED_ORIGINS=
# WORKOS_STATIC_ROOT=

# Local product profile (never combine with WORKOS_CLOUD_ROOT)
# WORKOS_LOCAL_ROOT=
# PORT=8790
# pnpm build && pnpm local:start
