{
  "name": "workos-ui20",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "dev:canonical": "node scripts/reclaim-dev-ports.mjs && vite",
    "ports:reclaim": "node scripts/reclaim-dev-ports.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "engine:dev": "pnpm --filter @workos-final/api dev",
    "engine:typecheck": "pnpm --filter @workos-final/domain typecheck && pnpm --filter @workos-final/api typecheck",
    "engine:lint": "eslint -c eslint.engine.config.js apps/api/src apps/api/tests packages/domain/src",
    "engine:test": "pnpm --filter @workos-final/domain test && pnpm --filter @workos-final/api test",
    "engine:build": "pnpm --filter @workos-final/domain build && pnpm --filter @workos-final/api build",
    "verify:all": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm engine:lint && pnpm engine:typecheck && pnpm engine:test && pnpm engine:build",
    "reference:start": "node scripts/reference-runtime.mjs start",
    "reference:status": "node scripts/reference-runtime.mjs status",
    "reference:restart": "node scripts/reference-runtime.mjs restart",
    "reference:seed": "node scripts/reference-runtime.mjs seed",
    "reference:reset": "node scripts/reference-runtime.mjs reset",
    "reference:stop": "node scripts/reference-runtime.mjs stop",
    "demo:init": "node scripts/demo-atelier.mjs init",
    "demo:setup": "node scripts/demo-atelier.mjs setup",
    "demo:start": "node scripts/demo-atelier.mjs start",
    "demo:stop": "node scripts/demo-atelier.mjs stop",
    "demo:status": "node scripts/demo-atelier.mjs status",
    "demo:prepare": "node scripts/demo-atelier.mjs prepare",
    "demo:verify": "node scripts/demo-atelier.mjs verify",
    "demo:manifest": "node scripts/demo-atelier.mjs manifest",
    "demo:cycle": "node scripts/demo-atelier.mjs cycle",
    "demo:stop-cycle": "node scripts/demo-atelier.mjs stop-cycle",
    "demo:report": "node scripts/demo-atelier.mjs report",
    "demo:history": "node scripts/demo-atelier.mjs history",
    "demo:chronology-plan": "node scripts/demo-atelier.mjs chronology-plan",
    "demo:chronology": "node scripts/demo-atelier.mjs chronology",
    "demo:backup": "node scripts/demo-atelier.mjs backup",
    "demo:restore-verify": "node scripts/demo-atelier.mjs restore-verify",
    "pilot:preflight": "pnpm --filter @workos-final/api cloud:pilot-preflight",
    "cloud:provision-organization": "pnpm --filter @workos-final/api cloud:provision-organization",
    "cloud:add-organization-user": "pnpm --filter @workos-final/api cloud:add-organization-user",
    "cloud:owner-review": "pnpm --filter @workos-final/api cloud:owner-review"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
